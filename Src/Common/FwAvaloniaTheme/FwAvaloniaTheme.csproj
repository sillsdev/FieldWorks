<Project Sdk="Microsoft.NET.Sdk">

	<!-- Holds the shared FieldWorks token dictionaries so the pure-C# foundation
		(Src/Common/FwAvalonia) and the XAML-compiled dialog project
		(Src/Common/FwAvaloniaDialogs)
	     resolve ONE token source without either depending on the other: FwAvalonia keeps its
	     documented independence from the Avalonia XAML compiler, FwAvaloniaDialogs keeps its
	     compiled-bindings pipeline. -->
	<PropertyGroup>
		<!-- net48 for in-process hosting beside WinForms, matching FwAvalonia/FwAvaloniaDialogs.
		     net8-only BCL features (Index/Range, IAsyncEnumerable, nint/nuint) therefore fail at
		     build rather than at review. -->
		<TargetFramework>net48</TargetFramework>
		<!-- Explicit RootNamespace so Crowdin/satellite-assembly localization builds work. -->
		<RootNamespace>FwAvaloniaTheme</RootNamespace>
		<!-- 'latest' for consistency with the sibling projects; the net48 TFM is what actually
		     bounds the usable language and BCL surface. -->
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Resource dictionaries only, no bindings, so
		     AvaloniaUseCompiledBindingsByDefault is deliberately left unset. -->
		<EnableDefaultAvaloniaItems>true</EnableDefaultAvaloniaItems>
		<NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- Avalonia 11.3.x is the last line still shipping netstandard2.0 assemblies, so it is
		     the last line that loads on net48; stay on 11.x until WinForms is removed. -->
		<PackageReference Include="Avalonia" ExcludeAssets="analyzers" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
	</ItemGroup>

</Project>
