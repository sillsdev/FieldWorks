<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>FwAvaloniaPreviewHost</AssemblyName>
		<RootNamespace>SIL.FieldWorks.Common.FwAvalonia.PreviewHost</RootNamespace>
		<TargetFramework>net48</TargetFramework>
		<!-- net48 BCL constraint applies: no records/init/Index/Range/DIM/IAsyncEnumerable. -->
		<LangVersion>latest</LangVersion>
		<OutputType>WinExe</OutputType>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<Prefer32Bit>false</Prefer32Bit>
		<IsPackable>false</IsPackable>
		<NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
		<!-- Built to a local folder, never the shared Output: the preview host is a developer tool
		     that must not ship. -->
		<OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" ExcludeAssets="analyzers" />
		<PackageReference Include="Avalonia.Desktop" ExcludeAssets="analyzers" />
		<PackageReference Include="Avalonia.Themes.Fluent" ExcludeAssets="analyzers" />
		<PackageReference Include="Semi.Avalonia" ExcludeAssets="analyzers" />
		<PackageReference Include="Irihi.Ursa" ExcludeAssets="analyzers" />
		<PackageReference Include="Irihi.Ursa.Themes.Semi" ExcludeAssets="analyzers" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FwAvalonia\FwAvalonia.csproj" />
		<!--
			Preview/**'s sample code lives in its own FwAvalonia.Preview assembly, referenced here
			and by FwAvaloniaTests.
		-->
		<ProjectReference Include="..\FwAvalonia\Preview\FwAvalonia.Preview.csproj" />
		<!-- Puts FwAvaloniaDialogs.dll beside this host's own bin\, not shared Output\, so its
		     module catalog finds it. The BuildAvaloniaApp entry point also lets Visual Studio's
		     XAML previewer host this exe. -->
		<ProjectReference Include="..\FwAvaloniaDialogs\FwAvaloniaDialogs.csproj" />
		<Compile Include="..\..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="FwAvaloniaPreviewHostTests/**/*.cs" />
	</ItemGroup>

</Project>
