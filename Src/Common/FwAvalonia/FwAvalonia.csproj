<Project Sdk="Microsoft.NET.Sdk">

	<!--
		FwAvalonia

		Owning project for the Avalonia lexical-edit migration: typed view-definition IR,
		migration seams, detail model, and the first-slice controls. Part of the normal repo
		build - included in the FieldWorks.proj traversal via the Src glob and listed in
		FieldWorks.sln.

		Targets net48 for in-process hosting beside WinForms. Avalonia 11.3.x is the
		last line that still ships netstandard2.0 assemblies and therefore loads on net48;
		stay on the 11.x line until WinForms is removed. UI is built in pure C# (no XAML) to
		keep the project independent of the Avalonia XAML compiler and the repo's customized
		MSBuild.
	-->
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<!--
			Explicit (same as the SDK default): the build localizer
			(ProjectLocalizer.GetResourceInfo)
		     needs it to produce FwAvalonia.resources.dll for FwAvaloniaStrings.resx. -->
		<RootNamespace>FwAvalonia</RootNamespace>
		<!-- net48 TFM: net8-only BCL features (Index/Range, IAsyncEnumerable, nint/nuint) fail at
		     build, not review; C# 8 is fine. LangVersion is 'latest' for init-only setters via a
		     local IsExternalInit shim. -->
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" ExcludeAssets="analyzers" PrivateAssets="all" />
		<PackageReference Include="Avalonia.Desktop" ExcludeAssets="analyzers" PrivateAssets="all" />
		<PackageReference Include="Avalonia.Themes.Fluent" ExcludeAssets="analyzers" PrivateAssets="all" />
		<PackageReference Include="Avalonia.Win32.Interoperability" ExcludeAssets="analyzers" PrivateAssets="all" />
		<PackageReference Include="Semi.Avalonia" ExcludeAssets="analyzers" PrivateAssets="all" />
		<PackageReference Include="Irihi.Ursa" ExcludeAssets="analyzers" PrivateAssets="all" />
		<PackageReference Include="Irihi.Ursa.Themes.Semi" ExcludeAssets="analyzers" PrivateAssets="all" />
		<!-- Canonical view-definition JSON serialization; repo-standard pin. -->
		<PackageReference Include="Newtonsoft.Json" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

	<!-- Shared color/brush + font-size token dictionary (Src/Common/FwAvaloniaTheme), merged into
	     Application.Resources by FwAvaloniaApp.Initialize(). -->
	<ItemGroup>
		<ProjectReference Include="..\FwAvaloniaTheme\FwAvaloniaTheme.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
	</ItemGroup>

	<!-- The test project lives in the nested FwAvaloniaTests/ folder. Exclude it from this
	     library's default SDK globbing so production and test trees do not mix. -->
	<ItemGroup>
		<Compile Remove="FwAvaloniaTests/**/*.cs" />
	</ItemGroup>

	<!-- Preview/ is dev-iteration sample code for FwAvaloniaPreviewHost, not shipped product
	     behavior. Excluded here so it does not compile into the product DLL. -->
	<ItemGroup>
		<Compile Remove="Preview/**/*.cs" />
	</ItemGroup>

	<!-- Produced by GenerateFwTokenKeys below, not the default glob: excluded here so it is
	     only ever added to @(Compile) once, whether or not a prior build left it on disk. -->
	<ItemGroup>
		<Compile Remove="GeneratedTokenKeys.g.cs" />
	</ItemGroup>

	<PropertyGroup>
		<FwTokenKeysGeneratedFile>$(MSBuildProjectDirectory)\GeneratedTokenKeys.g.cs</FwTokenKeysGeneratedFile>
		<FwColorTokensFile>$(MSBuildProjectDirectory)\..\FwAvaloniaTheme\Tokens\FwColorTokens.axaml</FwColorTokensFile>
		<DataTreeTokensFile>$(MSBuildProjectDirectory)\..\FwAvaloniaTheme\Tokens\DataTree\DataTreeTokens.axaml</DataTreeTokensFile>
		<DialogThemeTokensFile>$(MSBuildProjectDirectory)\..\FwAvaloniaDialogs\DialogTheme.axaml</DialogThemeTokensFile>
	</PropertyGroup>

	<!-- FwBuildTasks.dll is dropped to BuildTools/ before the solution graph builds (see
	     build.ps1's bootstrap step), so GenerateTokenKeys is resolvable at CoreCompile. -->
	<Import Project="$(MSBuildProjectDirectory)\..\..\..\Build\FwBuildTasks.targets" />

	<!-- Turns the token .axaml files' x:Key declarations into compile-time-safe C# constants,
	     so a typo'd/stale key is a compile error, not a runtime InvalidOperationException. -->
	<Target Name="GenerateFwTokenKeys" BeforeTargets="BeforeCompile;CoreCompile"
	        Inputs="$(FwColorTokensFile);$(DataTreeTokensFile);$(DialogThemeTokensFile)"
	        Outputs="$(FwTokenKeysGeneratedFile)">
		<GenerateTokenKeys
			FullKeyTokenFiles="$(FwColorTokensFile);$(DataTreeTokensFile)"
			PrefixedKeyTokenFile="$(DialogThemeTokensFile)"
			KeyPrefix="Dialog"
			OutputFile="$(FwTokenKeysGeneratedFile)"
			Namespace="SIL.FieldWorks.Common.FwAvalonia"
			ClassName="GeneratedTokenKeys"
		/>
		<ItemGroup>
			<Compile Remove="$(FwTokenKeysGeneratedFile)" />
			<Compile Include="$(FwTokenKeysGeneratedFile)" />
		</ItemGroup>
	</Target>

</Project>
