<Project Sdk="Microsoft.NET.Sdk">

	<!--
		FwAvalonia.Preview

		Dev-iteration sample/preview code for the Avalonia lexical-edit migration, NOT shipped
		product behavior. Split into its own assembly so it compiles exactly once and is
		referenced (not file-linked) by its two consumers:
		FwAvaloniaPreviewHost (the standalone dev preview tool, itself not part of the shipped installer)
		and FwAvaloniaTests (DetailPreviewTests.cs exercises it headlessly). FwAvalonia.csproj
		excludes this folder from its own compile, so none of this ever reaches the shipped FwAvalonia.dll.
	-->
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<RootNamespace>SIL.FieldWorks.Common.FwAvalonia.Preview</RootNamespace>
		<!-- Overrides the repo-wide C# 8.0: the view models and their tests use init-only setters. -->
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" ExcludeAssets="analyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FwAvalonia.csproj" />
	</ItemGroup>

</Project>
