<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FwAvaloniaDialogs"
             xmlns:res="clr-namespace:FwAvaloniaDialogs"
             x:Class="FwAvaloniaDialogs.EntryGoDialogView"
             x:DataType="vm:EntryGoDialogViewModel"
             Classes="fwDialogRoot"
             MinWidth="440" MinHeight="340">
	<!-- The reusable entry-search ("go") dialog body: the Avalonia replacement for the legacy
	     EntryGoDlg/BaseGoDlg family. PARITY (MatchingObjectsBrowser): the matching entries fill the dialog body as
	     a PERSISTENT, multi-column list under the search box — the shape of the legacy BaseGoDlg's embedded
	     MatchingObjectsBrowser — live-updating as the user types (an empty search shows an empty bordered area,
	     never a focus-gated overlay). A header row + per-row column cells are built by the code-behind from the
	     view-model's Columns (header text, result field, per-column writing-system typography), so a vernacular
	     column renders in the vernacular font and a gloss column in the analysis font. Up/Down in the search box
	     move the list selection without leaving the box (the legacy m_tbForm_KeyDown behavior). The optional
	     auxiliary picker sits UNDER the matching list (its legacy position), and the right-side description pane
	     exists only when the consumer opts in (HasDescriptionPane) — otherwise the list takes the full width.
	     The OK button text + title + prompts come from the launcher so each EntryGoDlg child re-skins the same
	     dialog. Visible text is localized via FwAvaloniaDialogsStrings; AutomationIds stay stable + nonlocalized. -->
	<DockPanel>
		<!-- Commit-on-select: there is NO OK button. Picking a result (double-click a row, or Enter in the search
		     box / on the highlighted row) commits + closes accepted (wired in code-behind to the CommitCommand).
		     The button strip keeps only a single Cancel affordance (Escape / the window close button also cancel,
		     via IsCancel) plus the optional Help, so the strip never reads as an empty placeholder.
		     EXCEPT in two-stage auxiliary mode (HasAuxiliarySelection): picking a result is stage 1, and PART_OkButton
		     below commits stage 2 (gated on both selections). For single-stage consumers the code-behind REMOVES
		     PART_OkButton from the tree entirely so the commit-on-select surface stays byte-identical. -->
		<!-- TabIndex=1 pushes the button strip AFTER the content in tab order; it is declared
		     first only so DockPanel docks it to the bottom. Content stays at the default TabIndex 0. -->
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" TabIndex="1"
		            HorizontalAlignment="Right" Spacing="{StaticResource DialogButtonStripGap}"
		            Margin="{StaticResource DialogControlGapAbove}">
			<Button Name="PART_OkButton" Command="{Binding OkCommand}"
			        AutomationProperties.AutomationId="EntryGo.Ok">
				<AccessText Text="{x:Static res:FwAvaloniaDialogsStrings.OkMnemonic}"/>
			</Button>
			<Button IsCancel="True" Command="{Binding CancelCommand}"
			        AutomationProperties.AutomationId="EntryGo.Cancel">
				<AccessText Text="{x:Static res:FwAvaloniaDialogsStrings.CancelMnemonic}"/>
			</Button>
			<Button IsVisible="{Binding HasHelp}" Command="{Binding HelpCommand}"
			        AutomationProperties.AutomationId="EntryGo.Help">
				<AccessText Text="{x:Static res:FwAvaloniaDialogsStrings.HelpMnemonic}"/>
			</Button>
		</StackPanel>

		<!-- The search column (always present) and the OPT-IN description pane on the right, separated by the
		     shared column-gutter token. When the consumer supplies no description label/content the code-behind
		     removes the gutter + pane from the tree and zeroes their grid columns, so the matching list takes
		     the full dialog width. -->
		<Grid Name="PART_BodyGrid" ColumnDefinitions="1.4*,Auto,*">
			<!-- ===== LEFT: the search column (toggle + prompt + search box + the persistent matching list, with
			     the optional auxiliary picker under the list). ===== -->
			<DockPanel Grid.Column="0">
				<!-- Entry/Sense mode toggle (opt-in: the legacy LinkEntryOrSenseDlg "Entry"/"Specific Sense" radios).
				     Hidden for entry-only consumers; disabled (but shown) when the consumer locks it to senses only. -->
				<StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
				            Spacing="{StaticResource DialogButtonStripGap}"
				            IsVisible="{Binding ShowModeToggle}"
				            Margin="{StaticResource DialogLabelFieldGapBelow}"
				            AutomationProperties.AutomationId="EntryGo.ModeToggle">
					<RadioButton GroupName="EntryGoMode" Content="{Binding EntryModeLabel}"
					             IsChecked="{Binding IsEntryMode, Mode=TwoWay}"
					             IsEnabled="{Binding ModeToggleEnabled}"
					             AutomationProperties.AutomationId="EntryGo.EntryMode"/>
					<RadioButton GroupName="EntryGoMode" Content="{Binding SenseModeLabel}"
					             IsChecked="{Binding IsSenseMode, Mode=TwoWay}"
					             IsEnabled="{Binding ModeToggleEnabled}"
					             AutomationProperties.AutomationId="EntryGo.SenseMode"/>
				</StackPanel>

				<!-- Search box (with optional prompt above it). Typing re-runs the search and the persistent list
				     below live-updates; Up/Down move the list selection while the caret stays here (code-behind). -->
				<TextBlock DockPanel.Dock="Top" Text="{Binding SearchPrompt}" TextWrapping="Wrap"
				           IsVisible="{Binding HasSearchPrompt}" Margin="{StaticResource DialogLabelFieldGapBelow}"
				           AutomationProperties.AutomationId="EntryGo.SearchPrompt"/>
				<TextBox DockPanel.Dock="Top" Name="PART_SearchBox"
				         Text="{Binding SearchText, Mode=TwoWay}"
				         Watermark="{x:Static res:FwAvaloniaDialogsStrings.EntryGoSearchWatermark}"
				         AutomationProperties.AutomationId="EntryGo.Search"/>

				<!-- Dependent auxiliary picker (two-stage mode only), UNDER the matching list — its legacy position
				     (the per-entry combo LinkMSADlg/LinkAllomorphDlg showed below the browser). Hidden until the
				     consumer supplies an auxiliary spec AND an entry is selected (ShowAuxiliaryOptions); a lone
				     option auto-selects in the VM, and OK stays gated until an option is chosen. -->
				<StackPanel DockPanel.Dock="Bottom"
				            IsVisible="{Binding ShowAuxiliaryOptions}"
				            Margin="{StaticResource DialogControlGapAbove}"
				            AutomationProperties.AutomationId="EntryGo.AuxiliarySection">
					<TextBlock Text="{Binding AuxiliaryLabel}"
					           Margin="{StaticResource DialogLabelFieldGapBelow}"
					           AutomationProperties.AutomationId="EntryGo.AuxiliaryLabel"/>
					<Border Classes="fwFieldHost">
						<ListBox MaxHeight="120"
						         ItemsSource="{Binding AuxiliaryOptions}"
						         SelectedItem="{Binding SelectedAuxiliaryOption, Mode=TwoWay}"
						         AutomationProperties.AutomationId="EntryGo.AuxiliaryOptions">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:EntryGoAuxiliaryOption">
									<TextBlock Text="{Binding Text}"
									           AutomationProperties.Name="{Binding Text}"/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Border>
				</StackPanel>

				<!-- The PERSISTENT matching list (PARITY: MatchingObjectsBrowser). A bordered header row + rows with
				     aligned proportional columns, filling the dialog body under the search box; it stays in the tree
				     even when empty. The header grid and the row template are built by the code-behind from the VM's
				     Columns so the column count, headers, and per-column typography are launcher-driven. -->
				<Border Classes="fwFieldHost" Margin="{StaticResource DialogControlGapAbove}"
				        AutomationProperties.AutomationId="EntryGo.ResultsPane">
					<DockPanel>
						<Grid DockPanel.Dock="Top" Name="PART_ResultsHeader"
						      AutomationProperties.AutomationId="EntryGo.ResultsHeader"/>
						<ListBox Name="PART_Results"
						         ItemsSource="{Binding Results}"
						         SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
						         AutomationProperties.AutomationId="EntryGo.Results"/>
					</DockPanel>
				</Border>
			</DockPanel>

			<!-- The column gutter between the search column and the (opt-in) description pane. -->
			<Border Grid.Column="1" Name="PART_DescriptionGutter" Margin="{StaticResource DialogColumnGutter}"/>

			<!-- ===== RIGHT (opt-in): the description pane — rich content for the highlighted entry, with the
			     plain description string as the graceful fallback. Present ONLY when the consumer supplies a
			     description label or rich row content (HasDescriptionPane); the code-behind removes it (and its
			     grid column) otherwise so the matching list takes the full width. ===== -->
			<DockPanel Grid.Column="2" Name="PART_DescriptionColumn">
				<TextBlock DockPanel.Dock="Top" Text="{Binding DescriptionLabel}"
				           IsVisible="{Binding HasDescriptionLabel}"
				           Margin="{StaticResource DialogLabelFieldGapBelow}"
				           AutomationProperties.AutomationId="EntryGo.DescriptionLabel"/>
				<Border Classes="fwFieldHost"
				        AutomationProperties.AutomationId="EntryGo.DescriptionPane">
					<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
						<Panel>
							<!-- Rich content for the highlighted entry (formatted text / picture / arbitrary control). -->
							<ContentControl Content="{Binding SelectedDescriptionContent}"
							                IsVisible="{Binding HasDescriptionContent}"
							                AutomationProperties.AutomationId="EntryGo.DescriptionContent"/>
							<!-- Plain-text fallback for consumers that supply only a one-line description. -->
							<TextBlock Text="{Binding Description}" TextWrapping="Wrap"
							           IsVisible="{Binding !HasDescriptionContent}"
							           AutomationProperties.AutomationId="EntryGo.Description"/>
						</Panel>
					</ScrollViewer>
				</Border>
			</DockPanel>
		</Grid>
	</DockPanel>
</UserControl>
