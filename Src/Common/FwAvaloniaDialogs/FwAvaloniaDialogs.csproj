<Project Sdk="Microsoft.NET.Sdk">

	<!--
		FwAvaloniaDialogs

		The dedicated XAML-enabled project for hand-authored Avalonia dialogs/wizards. Kept SEPARATE
		from the pure-C# foundation (Src/Common/FwAvalonia) so the foundation keeps its documented
		"independent of the Avalonia XAML compiler" guarantee; this project is where the XAML compiler
		+ CommunityToolkit.Mvvm + compiled bindings live. Builds as a first-class member of the main
		FieldWorks.proj traversal (in parallel, after its FwAvalonia dependency); restored via
		FieldWorks.sln.

		Targets net48 (Avalonia 11.3.x is the last line shipping netstandard2.0 - see
		Directory.Packages.props). The first real consumer is the Tools->Options dialog.
	-->
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<!-- Explicit RootNamespace so Crowdin/satellite-assembly localization builds work. -->
		<RootNamespace>FwAvaloniaDialogs</RootNamespace>
		<!-- net48 BCL constraint applies: no records/init/Index/Range/DIM/IAsyncEnumerable. -->
		<!-- Overrides the repo-wide C# 8.0: the view models and their tests use init-only setters. -->
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Auto-include *.axaml as AvaloniaXaml items and compile XAML at build time. -->
		<EnableDefaultAvaloniaItems>true</EnableDefaultAvaloniaItems>
		<!-- Bindings are statically checked at build time (the key payoff of the MVVM decision). -->
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" ExcludeAssets="analyzers" />
		<PackageReference Include="Semi.Avalonia" ExcludeAssets="analyzers" />
		<PackageReference Include="Irihi.Ursa" ExcludeAssets="analyzers" />
		<PackageReference Include="Irihi.Ursa.Themes.Semi" ExcludeAssets="analyzers" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
	</ItemGroup>

	<!-- WinForms reference: the dialog launcher scaffold takes an IWin32Window owner for
	     AvaloniaDialogHost.ShowModal during WinForms/Avalonia coexistence; net48 SDK-style
	     projects need it explicit. -->
	<ItemGroup>
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

	<!-- Reuse the foundation's owned writing-system-aware field controls + product strings inside dialogs. -->
	<ItemGroup>
		<ProjectReference Include="..\FwAvalonia\FwAvalonia.csproj" />
	</ItemGroup>

	<!-- Shared color/brush + font-size token dictionary, merged into DialogTheme.axaml's
	     Styles.Resources so {StaticResource FwSurfaceFontSize} etc. resolve. -->
	<ItemGroup>
		<ProjectReference Include="..\FwAvaloniaTheme\FwAvaloniaTheme.csproj" />
	</ItemGroup>

	<!-- The nested FwAvaloniaDialogsTests/ folder is excluded from this library's default SDK
	     globbing so it doesn't try to compile NUnit/Headless test code. -->
	<ItemGroup>
		<Compile Remove="FwAvaloniaDialogsTests/**/*.cs" />
		<AvaloniaXaml Remove="FwAvaloniaDialogsTests/**/*.axaml" />
	</ItemGroup>

</Project>
